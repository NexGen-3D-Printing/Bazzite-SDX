# run with --cap-add sys_admin --security-opt label=disable

ARG BASE_IMAGE=${BASE_IMAGE:-ghcr.io/nexgen-3d-printing/bazzite-sdx:latest}
ARG INSTALL_IMAGE_PAYLOAD=${INSTALL_IMAGE_PAYLOAD:-ghcr.io/nexgen-3d-printing/bazzite-sdx:latest}

FROM $BASE_IMAGE
ARG BASE_IMAGE
ARG INSTALL_IMAGE_PAYLOAD

RUN --mount=type=bind,source=.,target=/src \
    env \
    BASE_IMAGE="$BASE_IMAGE" \
    /src/build.sh
