#!/usr/bin/bash
set -euo pipefail

if [ "${EUID:-$(id -u)}" -lt 1000 ]; then
  echo "Bazzite-SDX user setup ran as unsupported user. Exiting."
  exit 0
fi

MARKER_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/bazzite-sdx"
mkdir -p "$MARKER_DIR"
MARKER="$MARKER_DIR/portal-pinned"
APP_DESKTOP="nexgen3d-sdx-portal.desktop"
APP_ID="nexgen3d-sdx-portal.desktop"

if [[ -f "$MARKER" ]]; then
  exit 0
fi

# GNOME: prepend NexGen3D SDX Portal to favorites (best effort)
if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q '^org.gnome.shell$'; then
  current="$(gsettings get org.gnome.shell favorite-apps 2>/dev/null || echo "[]")"
  if [[ "$current" != *"$APP_ID"* ]]; then
    # Prepend while preserving existing favorites
    if command -v python3 >/dev/null 2>&1; then
      new="$(python3 - "$current" "$APP_ID" <<'PY'
import ast, sys
cur = sys.argv[1]
app = sys.argv[2]
try:
    v = ast.literal_eval(cur)
    if not isinstance(v, list): v = []
except Exception:
    v = []
v = [app] + [x for x in v if x != app]
print("['" + "', '".join(v) + "']")
PY
)"
      gsettings set org.gnome.shell favorite-apps "$new" || true
    fi
  fi
fi

# KDE Plasma: best-effort favorites/pin hints.
# Plasma panel/task manager layout is version- and profile-specific; reliably
# mutating it from a generic image script is brittle. We attempt safe,
# non-destructive Kickoff favorites updates when config files exist.
if [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]] || command -v kwriteconfig6 >/dev/null 2>&1; then
  # Kickoff favorites (Plasma 5/6 commonly use kickoffrc; path varies)
  kickoffrc="${XDG_CONFIG_HOME:-$HOME/.config}/kickoffrc"
  if [[ -f "$kickoffrc" ]] && command -v kwriteconfig6 >/dev/null 2>&1; then
    # Common key: [Favorites] FavoriteURLs=
    favs="$(kreadconfig6 --file "$kickoffrc" --group Favorites --key FavoriteURLs 2>/dev/null || true)"
    if [[ -n "${favs:-}" && "$favs" != *"$APP_DESKTOP"* ]]; then
      kwriteconfig6 --file "$kickoffrc" --group Favorites --key FavoriteURLs "applications:$APP_DESKTOP,$favs" || true
    elif [[ -z "${favs:-}" ]]; then
      kwriteconfig6 --file "$kickoffrc" --group Favorites --key FavoriteURLs "applications:$APP_DESKTOP" || true
    fi
  fi
fi

touch "$MARKER"
